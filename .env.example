# Polymarket Configuration
#
# Note: POLYMARKET_PRIVATE_KEY is now loaded securely from Bitwarden.
# See bitwarden_loader.py for details on how to configure Bitwarden access.

# Required: Your Polymarket funder address
POLYMARKET_FUNDER_ADDRESS=0xYourFunderAddressHere

# Optional: Signature type (default: 1)
POLYMARKET_SIGNATURE_TYPE=1

# Optional: Polymarket API host (default: https://clob.polymarket.com)
POLYMARKET_HOST=https://clob.polymarket.com

# Optional: Chain ID (default: 137 for Polygon)
POLYMARKET_CHAIN_ID=137

# Optional: Bitwarden Configuration
# Specify either the item ID or item name containing your private key
# If not set, you can pass item_name or item_id as parameters to the loader
# BW_POLYMARKET_ITEM_ID=your-bitwarden-item-id
# BW_POLYMARKET_ITEM_NAME=Polymarket Private Key
