# What the farmer, the console, the worker and the scoring probe read when they
# start. Copy this file to .env beside it and fill it in. A variable already set
# in the real environment wins over its line here.

# Required. The address that holds the funds and the positions.
POLYMARKET_FUNDER_ADDRESS=0xYourFunderAddressHere

# Optional. How orders are signed (default: 1).
# POLYMARKET_SIGNATURE_TYPE=1

# Optional. The chain id (default: 137, Polygon).
# POLYMARKET_CHAIN_ID=137

# Optional. A builder code to attach to every order.
# POLY_BUILDER_CODE=

# The wallet's private key. A live farmer, the worker and the scoring probe read
# POLYMARKET_PRIVATE_KEY when it is set, and otherwise the secure note of a
# Bitwarden item. POLYMARKET_KEY_SOURCE=env or =bitwarden reads that source
# alone. A dry-run farmer and the console read no key, and --key-stdin takes the
# key from standard input instead of from either source.
# POLYMARKET_KEY_SOURCE=bitwarden
# POLYMARKET_PRIVATE_KEY=

# The Bitwarden item whose note is the key: its id, or a name to search for.
# The Bitwarden CLI (bw) must be installed and logged in: run `bw login` once
# by hand. A locked vault is unlocked with the master password the program asks
# for, and locked again as soon as the key is read.
# BW_POLYMARKET_ITEM_ID=your-bitwarden-item-id
# BW_POLYMARKET_ITEM_NAME=Polymarket Private Key

# A host override does not belong in this file, because the farmer and the
# console read the hosts before they load it. Set POLYMARKET_HOST,
# POLYMARKET_GAMMA_HOST, POLYMARKET_DATA_API_HOST or POLYMARKET_WSS_HOST in the
# real environment.
