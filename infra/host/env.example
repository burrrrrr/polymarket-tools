# The server's replacement for .env. bootstrap.sh copies this file to
# /etc/polymarket/env once and never overwrites it. The three units read it.
#
# systemd reads this file, not a shell: one NAME=value on a line, no `export`,
# no $VARIABLE expansion, and a # only starts a comment at the start of a line.
# See .env.example in the repo root for the optional variables.

# Where farm.db, farm_books.db and tools.db live. bootstrap.sh mounts the data
# disk here.
POLYMARKET_DATA_DIR=/var/lib/polymarket

# Required. The address that holds the funds and the positions.
POLYMARKET_FUNDER_ADDRESS=0xYourFunderAddressHere

# Extra flags for the farmer, split on spaces, for example: --interval 10
# Leave --heartbeat out until its scope is confirmed. See "The heartbeat
# warning" in docs/farmer.md.
FARMER_ARGS=
